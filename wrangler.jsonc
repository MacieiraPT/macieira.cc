{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macieira-cc",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_als"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "build": {
    "command": "npm run build",
    "watch_dir": "src"
  },
  "workers_dev": true,
  "preview_urls": true
}
