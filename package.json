{
  "name": "macieira.cc",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio and engineering case studies for Rodrigo Macieira (MacieiraPT): SvelteKit + TypeScript + Cloudflare Workers + 16-bit retro Three.js.",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev --port 4321",
    "build": "vite build",
    "preview": "wrangler dev --port 4321",
    "prepare": "svelte-kit sync || echo ''",
    "check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "wrangler deploy",
    "gen": "wrangler types",
    "og": "node tools/og.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
