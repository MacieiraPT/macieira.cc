# Cloudflare Pages headers.
# Applied at the edge; no build step reads this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  # A year, subdomains included. The site is HTTPS-only and has no subdomain
  # serving anything, so there is nothing here to break. Deliberately without
  # the `preload` token: that one is a submission to a browser-baked list that
  # takes months to get out of, and it should be a decision rather than a
  # side effect of adding the header.
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Everything is same-origin except two things the page genuinely needs:
  # the GitHub API (the live dev panel) and GitHub's avatar CDN.
  # 'unsafe-inline' is required for the import map and the capability probe in
  # <head>; with no user input and no third-party scripts on the page, the
  # remaining directives are where the actual protection is.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Safe to cache forever ONLY because the import map in index.html stamps every
# entry with the bundle's content hash (?v=...), which `npm run vendor` rewrites
# on every build. Without that stamp these file names never change, and shipping
# a rebuilt bundle strands returning visitors on the copy they already have —
# for a year. Do not add anything to /vendor that isn't stamped that way.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

# Application code changes without changing its filename, so it revalidates.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate
