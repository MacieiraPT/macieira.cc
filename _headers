# Cloudflare Pages headers.
# Applied at the edge; no build step reads this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # Everything is same-origin except two things the page genuinely needs:
  # the GitHub API (the live dev panel) and GitHub's avatar CDN.
  # 'unsafe-inline' is required for the import map and the capability probe in
  # <head>; with no user input and no third-party scripts on the page, the
  # remaining directives are where the actual protection is.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' https://api.github.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Content-addressed by version: safe to cache forever.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

# Application code changes without changing its filename, so it revalidates.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

/styles/*
  Cache-Control: public, max-age=0, must-revalidate
