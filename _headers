# Cloudflare Workers edge headers (merged with SvelteKit immutable app rules at build time).
# HTML pages also carry SvelteKit's hash-mode <meta http-equiv="content-security-policy">
# (strict script-src 'self' + per-page hydration sha256 hash), while this header enforces
# HTTP-only framing/base/object/form directives without colliding with per-page script hashes.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'none'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/boot.js
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=604800
